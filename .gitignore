# secrets — never commit
.env
*.key

# python
# The environment lives in venv.nosync -- iCloud skips any name ending in
# .nosync, so it cannot be evicted -- and `venv` is a symlink to it. Both
# patterns are needed: `venv/` matches only directories, and a symlink is a file.
venv
venv/
venv.nosync/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# os
.DS_Store

# large/derived artifacts (raw trial data IS committed — see README)
results/figures/*.png
!results/figures/.gitkeep
results/logs/
